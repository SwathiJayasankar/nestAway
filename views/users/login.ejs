<% layout("/layouts/boilerplate") -%>

<div class="form-card auth-card">
    <h2 class="text-center">Welcome back</h2>
    <p class="text-center text-muted mb-4">Log in to your NestAway account</p>
    <form action="/login" method="POST" class="needs-validation" novalidate>
        <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input name="username" id="username" type="text" class="form-control" placeholder="Your username" required>
        </div>
        <div class="mb-4">
            <label for="password" class="form-label">Password</label>
            <input name="password" id="password" type="password" class="form-control" placeholder="Your password" required>
        </div>
        <button class="btn btn-primary w-100 add-btn">Log in</button>
        <p class="text-center mt-3 mb-0 text-muted">
            New here? <a href="/signup" class="text-decoration-none" style="color: var(--primary); font-weight: 600;">Sign up</a>
        </p>
    </form>
</div>
