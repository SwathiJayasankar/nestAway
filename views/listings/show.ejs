<% layout("/layouts/boilerplate") -%>


    <div class="show-page">
        <div class="row g-4 mb-4">
            <div class="col-lg-7">
                <div class="show-img-wrap">
                    <img src="<%= listing.image %>" class="show-img" alt="<%= listing.title %>">
                </div>
            </div>
            <div class="col-lg-5">
                <div class="show-details-card">
                    <h1 class="show-title"><%= listing.title %></h1>
                    <p class="show-meta">
                        <i class="fa-regular fa-user"></i>
                        Hosted by <strong><%= listing.owner ? listing.owner.username : 'Anonymous' %></strong>
                    </p>
                    <p class="show-price">
                        &#8377; <%= listing.price.toLocaleString("en-IN") %>
                        <span>/ night</span>
                    </p>
                    <p class="show-description"><%= listing.description %></p>
                    <div class="show-location-tags">
                        <span class="location-tag">
                            <i class="fa-solid fa-location-dot"></i>
                            <%= listing.location %>
                        </span>
                        <span class="location-tag">
                            <i class="fa-solid fa-globe"></i>
                            <%= listing.country %>
                        </span>
                        <% if (listing.category) { %>
                        <span class="location-tag">
                            <i class="fa-solid fa-tag"></i>
                            <%= categoryLabel %>
                        </span>
                        <% } %>
                    </div>
                </div>

                <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
                <div class="btns">
                    <a href="/<%= listing._id %>/edit" class="btn btn-primary add-btn">
                        <i class="fa-solid fa-pen me-1"></i> Edit
                    </a>
                    <form method="POST" action="/<%= listing._id %>?_method=DELETE">
                        <button class="btn btn-danger-soft">
                            <i class="fa-solid fa-trash me-1"></i> Delete
                        </button>
                    </form>
                </div>
                <% } %>
            </div>
        </div>

        <div class="map-section">
            <h5><i class="fa-solid fa-map-location-dot me-2"></i>Where you'll be</h5>
            <%- include("../includes/listingMap.ejs", { listing, mapSize: "map-lg" }) %>
        </div>

        <div class="reviews-section col-12">
            <% if(currUser) { %>
            <div class="review-form-card">
                <h4>Leave a review</h4>
                <form action="/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
                    <div class="mb-3">
                        <label class="form-label">Rating</label>
                        <div class="star-rating-input">
                            <input type="hidden" name="review[rating]" id="rating" value="5" required>
                            <div class="stars" role="radiogroup" aria-label="Rating">
                                <% for (let i = 1; i <= 5; i++) { %>
                                    <button type="button" class="star-btn" data-value="<%= i %>" aria-label="<%= i %> stars">
                                        <i class="fa-solid fa-star"></i>
                                    </button>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="comment" class="form-label">Comments</label>
                        <textarea name="review[comment]" id="comment" rows="4" class="form-control" required placeholder="Share your experience..."></textarea>
                        <div class="invalid-feedback">Add a comment for your review</div>
                    </div>
                    <button class="btn btn-primary">Submit review</button>
                </form>
            </div>
            <% } %>

            <h5><i class="fa-regular fa-comment me-2"></i>Guest reviews</h5>
            <% if(listing.reviews.length === 0) { %>
                <p class="text-muted">No reviews yet. Be the first to share your stay!</p>
            <% } %>
            <div class="row g-3">
            <% for(review of listing.reviews) { %>
                <div class="col-md-6">
                    <div class="card review-card h-100">
                        <div class="card-body">
                            <h6 class="card-title">@<%= review.author ? review.author.username : 'Anonymous' %></h6>
                            <%- include("../includes/starDisplay.ejs", { rating: review.rating }) %>
                            <p class="card-text mt-2 mb-3"><%= review.comment %></p>
                            <% if(currUser && review.author && review.author._id.equals(currUser._id)) { %>
                            <form method="POST" action="/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                <button class="btn btn-sm btn-danger-soft">Delete</button>
                            </form>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>
            </div>
        </div>
    </div>
    <%- include("../includes/mapAssets.ejs") %>
