<% layout("/layouts/boilerplate") -%>

    <div class="hero">
        <h1>Find your next stay</h1>
        <p>Discover unique homes and experiences in destinations around the world with NestAway.</p>
    </div>

    <%- include("../includes/categoryFilters.ejs") %>

    <div class="page-header">
        <h3><%= activeLabel %></h3>
        <p class="subtitle">
            <%= allListings.length %> <%= allListings.length === 1 ? 'place' : 'places' %> available
        </p>
    </div>

    <% if (allListings.length === 0) { %>
        <div class="empty-state">
            <i class="fa-solid fa-magnifying-glass"></i>
            <% if (searchQuery) { %>
                <h4>No stays found for "<%= searchQuery %>"</h4>
                <p>Try a different location, country, or listing title.</p>
            <% } else { %>
                <h4>No stays in this category yet</h4>
                <p>Try another filter or host the first stay in this category.</p>
            <% } %>
            <a href="/" class="btn btn-primary add-btn mt-2">View all stays</a>
        </div>
    <% } else { %>
    <div class="row listing-grid row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">
        <% for(let listing of allListings){ %>
        <div class="col">
            <a href="/<%= listing._id %>" class="listing-link">
                <div class="card listing-card h-100">
                    <div class="card-img-wrap">
                        <img src="<%= listing.image %>" class="card-img-top" alt="<%= listing.title %>"/>
                    </div>
                    <div class="card-body">
                        <p class="card-title-text"><%= listing.title %></p>
                        <p class="card-location">
                            <i class="fa-solid fa-location-dot"></i>
                            <%= listing.location %>, <%= listing.country %>
                        </p>
                        <p class="card-price">
                            &#8377; <%= listing.price.toLocaleString("en-IN") %>
                            <span>/ night</span>
                        </p>
                    </div>
                </div>
            </a>
        </div>
        <% } %>
    </div>
    <% } %>
