<nav class="navbar navbar-expand-md sticky-top">
  <div class="container">
    <a class="navbar-brand" href="/"><i class="fa-regular fa-compass"></i> NestAway</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav align-items-md-center navbar-left">
        <a class="nav-link" href="/"><i class="fa-solid fa-compass me-1"></i> Explore</a>
        <form class="navbar-search" action="/" method="GET" role="search">
          <i class="fa-solid fa-magnifying-glass navbar-search-icon" aria-hidden="true"></i>
          <input
            type="search"
            name="search"
            class="navbar-search-input"
            placeholder="Search destinations, stays..."
            value="<%= searchQuery || '' %>"
            aria-label="Search listings"
          >
          <% if (activeCategory && activeCategory !== 'trending') { %>
            <input type="hidden" name="category" value="<%= activeCategory %>">
          <% } %>
        </form>
      </div>

      <div class="navbar-nav ms-auto align-items-md-center">
        <% if(currUser) { %>
        <a class="nav-link" href="/new"><i class="fa-solid fa-plus me-1"></i> Host a stay</a>
        <a class="nav-link" href="/logout">Log out</a>
        <% } else { %>
        <a class="nav-link" href="/login">Log in</a>
        <a class="nav-link btn-nav-cta" href="/signup">Sign up</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
